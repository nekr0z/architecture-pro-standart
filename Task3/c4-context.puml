@startuml c4-context
!include <C4/C4_Context>

title Банк «Стандарт» — открытие депозита (MVP)\nC4 · Контекст
skinparam wrapWidth 180

Person(newclient, "Новый клиент", "Выбирает депозит, затем проходит идентификацию в отделении")
Person(client, "Клиент банка", "Подаёт заявку со своего счёта")
Person(operator, "Оператор кол-центра", "Обсуждает условия с новым клиентом")
Person(front, "Сотрудник отделения", "Проверяет документы, оформляет депозит")
Person(back, "Менеджер депозитов", "Ведёт ставки и согласует условия заявок")
Person(risk, "Менеджер кредитования", "Готовит базовые ставки и оценку риска")

System(site, "Сайт банка", "Публичные ставки и заявка на обратный звонок")
System(cc, "Система кол-центра", "Обращение и результат звонка")
System(ib, "Интернет-банк", "Публикация ставок и приём подтверждённых онлайн-заявок")
System(absys, "АБС", "Утверждённые ставки, рассмотрение заявки и открытие депозита")
System_Ext(sms, "СМС-шлюз", "Доставка СМС через телеком-оператора")

Rel(newclient, site, "Выбирает депозит, оставляет Ф. И. О. и телефон", "HTTPS")
Rel(operator, newclient, "Обсуждает условия и приглашает в отделение", "Телефон")
Rel(newclient, front, "Предъявляет документы", "Лично")
Rel(operator, cc, "Читает заявку, фиксирует условия звонка")
Rel(site, cc, "Передаёт обращение", "HTTPS")
Rel(cc, absys, "Передаёт номер заявки и условия после звонка")
Rel(site, ib, "Запрашивает опубликованные общие ставки", "HTTPS")
Rel(client, ib, "Выбирает счёт и сумму, вводит СМС-код", "HTTPS")
Rel(absys, ib, "Публикует ставки и изменённые условия, забирает заявки", "Фоновый обмен по HTTPS")
Rel(ib, sms, "Отправляет код подтверждения")
Rel(absys, sms, "Извещает о ставке и об открытии")
Rel(front, absys, "Находит заявку после идентификации, загружает документы")
Rel(back, absys, "Утверждает ставку и обрабатывает заявку")
Rel(risk, absys, "Вносит ставку и оценку риска в своём разделе")

SHOW_LEGEND()
@enduml
