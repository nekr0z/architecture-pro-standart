@startuml c4-component
!include <C4/C4_Component>
title Банк «Стандарт» — выдача общих ставок\nC4 · Компоненты сервиса депозитов
Container_Ext(adapter, "Адаптер депозитов АБС", "Java", "Передаёт утверждённые изменения из АБС")
System_Ext(cc, "Кол-центр банка", "Сервер приложения оператора")
ContainerDb(store, "БД интернет-банка", "MS SQL", "Версии, сроки действия и состояние выгрузки")
System_Ext(files, "Файловый узел банка", "Каталог выгрузки и каталог подтверждений")
System_Ext(partner, "Система партнёра", "Импортирует CSV и показывает ставки")
Container_Boundary(svc, "Сервис депозитов · C# / .NET") {
  Component(load, "Приём изменений", "Компонент", "Применяет обновление АБС целиком")
  Component(cat, "Каталог общих ставок", "Компонент", "Читает согласованную версию публичных условий")
  Component(api, "API каталога", "Компонент", "Отдаёт ставки и срок действия системе оператора")
  Component(job, "Файловая выгрузка", "Фоновая задача", "Формирует CSV, повторяет доставку и сверяет подтверждения")
}
Rel(adapter, load, "Передаёт версию и изменения", "HTTPS")
Rel(load, store, "Сохраняет версию", "SQL")
Rel(cat, store, "Читает только общие условия", "SQL")
Rel(cc, api, "Запрашивает действующие ставки", "HTTPS")
Rel(api, cat, "Читает каталог на текущий момент")
Rel(job, cat, "Читает полный снимок одной версии")
Rel(job, store, "Отмечает передачу и подтверждение", "SQL")
Rel(job, files, "Публикует CSV, читает подтверждения", "SFTP")
Rel(partner, files, "Получает CSV, подтверждает импорт", "SFTP")
SHOW_LEGEND()
@enduml
