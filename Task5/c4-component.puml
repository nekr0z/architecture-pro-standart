@startuml c4-component
!include <C4/C4_Component>
title Банк «Стандарт» — онлайн-заявка на кредит\nC4 · Компоненты приложения Кредитного конвейера
System_Ext(site, "Сайт банка", "Публичный канал")
System_Ext(ib, "Интернет-банк", "Подтверждает подачу кодом из СМС")
System_Ext(absys, "АБС", "Рабочее место отделения и учёт выдачи")
Person(manager, "Менеджер кредитования")
Container_Boundary(app, "Приложение Кредитного конвейера · Camunda / Java") {
    Component(api, "API кредитных заявок", "HTTPS / Java", "Проверяет права канала, принимает заявки и запросы по номеру")
    Component(offers, "Каталог и предложения", "Java", "Выбирает действующие условия и персональный лимит")
    Component(flow, "Рассмотрение заявки", "Camunda BPMN / Java", "Выбирает режим скоринга, создаёт задачу менеджеру, фиксирует решение")
    Component(notify, "Отправка уведомлений", "Фоновый обработчик Java", "Читает ожидающие отправки СМС и повторяет доставку при сбое")
}
ContainerDb(db, "БД Кредитного конвейера", "Oracle", "Условия, оценки, лимиты, заявки, статусы и записи для СМС")
System_Ext(score, "Система кредитного скоринга", "Для нового клиента запрашивает только данные БКИ")
System_Ext(sms, "СМС-шлюз", "Доставляет приглашения и статусы")
Rel(site, api, "Каталог и заявка", "HTTPS")
Rel(ib, api, "Предложения и заявка с подтверждением", "HTTPS")
Rel(absys, api, "Поиск и оформление в отделении", "HTTPS")
Rel(api, offers, "Читает доступные предложения")
Rel(api, flow, "Запускает или продолжает одну заявку")
Rel(manager, flow, "Обрабатывает задачу в конвейере")
Rel(offers, db, "Читает условия и действующие лимиты", "SQL")
Rel(flow, score, "Запрашивает оценку по заявке", "REST / HTTPS")
Rel(flow, db, "Сохраняет заявку, оценку, решение и запись для СМС", "SQL")
Rel(notify, db, "Забирает записи для отправки", "SQL")
Rel(notify, sms, "Отправляет СМС по событию")
SHOW_LEGEND()
@enduml
