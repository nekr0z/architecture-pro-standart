@startuml c4-context
!include <C4/C4_Context>
title Банк «Стандарт» — онлайн-заявка на кредит\nC4 · Контекст Кредитного конвейера
Person(visitor, "Новый клиент")
Person(customer, "Клиент банка")
Person(front, "Менеджер отделения")
Person(underwriter, "Менеджер кредитования")
System_Ext(site, "Сайт банка", "Общие условия и заявка нового клиента")
System_Ext(ib, "Интернет-банк", "Предложения, выбор счёта и подтверждение заявки")
System_Ext(absys, "АБС", "Идентификация в отделении и зачисление кредита")
System(pipeline, "Кредитный конвейер", "Условия продуктов, заявки и решения банка")
System_Ext(score, "Система кредитного скоринга", "Оценивает клиента по правилам выбранного сценария")
System_Ext(bki, "Бюро кредитных историй", "Предоставляет кредитную историю онлайн")
System_Ext(sms, "СМС-шлюз", "Доставляет коды и уведомления")

Rel(visitor, site, "Смотрит условия и подаёт заявку", "HTTPS")
Rel(customer, ib, "Выбирает кредит и счёт, вводит код", "HTTPS")
Rel(front, absys, "Проверяет документы и продолжает заявку")
Rel(underwriter, pipeline, "Рассматривает заявку и фиксирует решение")
Rel(site, pipeline, "Читает каталог, подаёт заявку, получает предварительное решение", "HTTPS")
Rel(ib, pipeline, "Читает предложения, подаёт подтверждённую заявку", "HTTPS")
Rel(ib, sms, "Отправляет код подтверждения")
Rel(absys, pipeline, "Находит, дополняет или создаёт заявку в отделении", "HTTPS")
Rel(pipeline, absys, "Передаёт одобренные заявки на зачисление", "Суточный обмен БД")
Rel(pipeline, score, "Запрашивает оценку конкретной заявки", "REST / HTTPS")
Rel(score, bki, "Запрашивает кредитную историю", "REST / HTTPS")
Rel(pipeline, sms, "Отправляет приглашение в отделение и изменения статуса")
SHOW_LEGEND()
@enduml
